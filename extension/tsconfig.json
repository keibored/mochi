{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext",
    "moduleResolution": "bundler", "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "strict": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "types": ["node", "vite/client"], "erasableSyntaxOnly": true
  },
  "include": ["src", "vite.config.ts"]
}
